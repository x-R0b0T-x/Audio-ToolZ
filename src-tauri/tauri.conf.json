{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Audio ToolZ",
  "version": "1.8.0",
  "identifier": "com.audiotoolz.studio",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:3000",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "dragDropEnabled": false,
        "title": "Audio ToolZ 1.8",
        "width": 1360,
        "height": 900,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "maximized": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self' blob: data:; script-src 'self' blob: 'unsafe-inline' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; media-src 'self' blob: data:; worker-src 'self' blob:"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "../src/medias/logo.ico",
      "../src/medias/logo.png"
    ]
  }
}
